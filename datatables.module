<?php

/**
 * @file
 * Provides integration of the jQuery DataTables plugin
 */

/**
 * Implements hook_theme().
 */
function datatables_theme() {
  return array(
    'datatable' => array(
      'variables' => array(
        'header' => NULL,
        'rows' => NULL,
        'attributes' => NULL,
        'caption' => NULL,
      ),
    ),
    'datatable_tableselect' => array(
      'render element' => 'element',
    )
  );
}

/**
 * Implements hook_library_info().
 */
function datatables_library_info() {
  $libraries = array();

  $lib_path = backdrop_get_path('module', 'datatables') . '/DataTables';

  // Make sure we have a valid library path before returning library load info.
  if (!empty($lib_path)) {
    $libraries['datatables'] = array(
      'title' => 'DataTables',
      'website' => 'https://datatables.net/',
      'version' => '2.3.8',
      'js' => array(
        $lib_path . '/dataTables.min.js' => array(),
        $lib_path . '/dataTables.responsive.min.js' => array(),
        $lib_path . '/dataTables.scroller.min.js' => array(),
        backdrop_get_path('module', 'datatables') . '/js/datatables.js' => array(),
      ),
      'css' => array(
        $lib_path . '/dataTables.dataTables.min.css' => array(),
        $lib_path . '/responsive.dataTables.min.css' => array(),
        $lib_path . '/scroller.dataTables.min.css' => array(),
        backdrop_get_path('module', 'datatables') . '/css/datatables.css' => array(),
      ),
    );

    $libraries['datatables-buttons'] = array(
      'title' => 'Buttons (successor of Tabletools) plugin for DataTables',
      'website' => 'https://datatables.net/extensions/buttons',
      'version' => '3.2.6',
      'js' => array(
        $lib_path . '/dataTables.buttons.js' => array(),
        $lib_path . '/buttons.colVis.js' => array(),
        $lib_path . '/buttons.html5.js' => array(), // Copy button
        $lib_path . '/buttons.print.js' => array(), // Print button
        $lib_path . '/jszip.js' => array(), // Excel Export button
        $lib_path . '/pdfmake.js' => array(), // PDF Export button
        $lib_path . '/vfs_fonts.js' => array(), // PDF Export button
      ),
      'css' => array(
        $lib_path . '/buttons.dataTables.min.css' => array(),
      ),
      'dependencies' => array(
        array('datatables', 'datatables'),
      ),
    );
  }

  return $libraries;
}

/**
 * Implements hook_views_api().
 */
function datatables_views_api() {
  return array(
    'api' => 3.0,
    'path' => backdrop_get_path('module', 'datatables') . '/views',
  );
}

/**
 * Return a themed DataTable.
 *
 * This function takes the same parameters as theme_table, but also allows the
 * inclusion of DataTable specific information in the $header and $attributes
 * parameters in order to configure a DataTable.  If an id is not set in the
 * $attributes paramater, a unique one is generated.
 *
 * To set features and options for the DataTable, add
 * $parameters['datatable_options'] as an associative array.
 * For example:
 * @code
 *   $parameters['datatable_options'] = array(
 *     'filter'   => FALSE,  // Disable filtering of data.
 *     'info'     => TRUE,   // Show the table information display.
 *     'order' => array(  // Sort by 3rd column first, and then 4th column.
 *        array(2, 'asc'),
 *        array(3, 'desc'),
 *      ),
 *   );
 * @endcode
 *
 * Then, these parameters must be passed to the theming function under the `attributes` key, as in:
 * @code
 *   $output = theme('datatable', array('header' => $header, 'rows' => $rows, 'attributes' => $parameters));
 * @endcode
 * See https://datatables.net/reference/feature/ and
 * https://datatables.net/reference/option/ for a full list of features and options.
 *
 * To enable column specific options, set the datatable_options for each of the
 * columns in the $header parameter.
 * For example:
 * @code
 *   $header = array(
 *     array(
 *       'data' => t('Column 1'),
 *       'datatable_options' => array(
 *        'orderable' => TRUE,  // Enable sorting on this column.
 *       ),
 *     ),
 *     array(
 *       'data' => t('Column 2'),
 *       'datatable_options' => array(
 *         'searchable' => FALSE, // Disable filtering on this column.
 *       ),
 *     ),
 *   );
 * @endcode
 * Note: if the columns option is enabled in $parameters['datatable_options'],
 * then all datatable_options in the $header parameter will be ignored, since
 * the parameters will override column options.  See
 * https://datatables.net/reference/option/ for a full list of column options.
 *
 * @param array $variables
 *   An associative array containing:
 *   - header: An array containing the table headers. Each element of the array
 *     can be either a localized string or an associative array with the
 *     following keys:
 *     - "data": The localized title of the table column.
 *     - "field": The database field represented in the table column (required
 *       if user is to be able to sort on this column).
 *     - "sort": A default sort order for this column ("asc" or "desc").
 *     - Any HTML attributes, such as "colspan", to apply to the column header
 *       cell.
 *     - "datatable_options": An associative array containing DataTable column
 *       specific features/options.
 *   - rows: An array of table rows. Every row is an array of cells, or an
 *     associative array with the following keys:
 *     - "data": an array of cells
 *     - Any HTML attributes, such as "class", to apply to the table row.
 *     - "no_striping": a boolean indicating that the row should receive no
 *       'even / odd' styling. Defaults to FALSE.
 *     Each cell can be either a string or an associative array with the
 *     following keys:
 *     - "data": The string to display in the table cell.
 *     - "header": Indicates this cell is a header.
 *     - Any HTML attributes, such as "colspan", to apply to the table cell.
 *     Here's an example for $rows:
 *     @code
 *     $rows = array(
 *       // Simple row
 *       array(
 *         'Cell 1', 'Cell 2', 'Cell 3'
 *       ),
 *       // Row with attributes on the row and some of its cells.
 *       array(
 *         'data' => array('Cell 1', array('data' => 'Cell 2', 'colspan' => 2)),
 *         'class' => array('funky')
 *       )
 *     );
 *     @endcode
 *   - attributes: An array of HTML attributes to apply to the table tag. Use
 *     the key 'datatable_options' to pass an array of DataTable options.
 *   - caption: A localized string to use for the <caption> tag.
 *   - colgroups: An array of column groups. Each element of the array can be
 *     either:
 *     - An array of columns, each of which is an associative array of HTML
 *       attributes applied to the COL element.
 *     - An array of attributes applied to the COLGROUP element, which must
 *       include a "data" attribute. To add attributes to COL elements, set the
 *       "data" attribute with an array of columns, each of which is an
 *       associative array of HTML attributes.
 *     Here's an example for $colgroup:
 *     @code
 *     $colgroup = array(
 *       // COLGROUP with one COL element.
 *       array(
 *         array(
 *           'class' => array('funky'), // Attribute for the COL element.
 *         ),
 *       ),
 *       // Colgroup with attributes and inner COL elements.
 *       array(
 *         'data' => array(
 *           array(
 *             'class' => array('funky'), // Attribute for the COL element.
 *           ),
 *         ),
 *         'class' => array('jazzy'), // Attribute for the COLGROUP element.
 *       ),
 *     );
 *     @endcode
 *     These optional tags are used to group and set properties on columns
 *     within a table. For example, one may easily group three columns and
 *     apply same background style to all.
 *   - sticky: Use a "sticky" table header.
 *   - empty: The message to display in an extra row if table does not have any
 *     rows.
 *  - attributes: An array of HTML attributes to apply to the table tag.  If the
 *   datatable_options is set, then those options are passed to the dataTable
 *   constructor.
 *  - caption: A localized string to use for the <caption> tag.
 *
 * @return string
 *   An HTML string representing the table.
 * @see theme_table()
 */
function theme_datatable($variables) {
  $header = &$variables['header'];
  $attributes = &$variables['attributes'];

  if (!empty($variables['rows'])) {
    $datatable_options = !empty($attributes['datatable_options']) ? $attributes['datatable_options'] : array();

    // Column settings can either be set with the global options
    // or in each header definition.
    if (!isset($datatable_options['columns'])) {
      foreach ($header as $key => $cell) {
        if (isset($cell['datatable_options'])) {
          $datatable_options['columns'][] = $cell['datatable_options'];
          if (is_array($header[$key])) {
            unset($header[$key]['datatable_options']);
          }
        }
      }
    }

    // Set unique id.
    if (!isset($attributes['id'])) {
      $attributes['id'] = _datatables_get_id();
    }

    backdrop_add_library('datatables', 'datatables');
    backdrop_add_js(array('datatables' => array('#' . $attributes['id'] => $datatable_options)), 'setting');
    unset($attributes['datatable_options']);
  }

  return theme('table', $variables);
}

/**
 * Display a view as a DataTable style.
 */
function template_preprocess_datatables_view(&$vars) {
  // Run views table preprocess function to handle putting rows in columns,
  // classes, etc.
  template_preprocess_views_view_table($vars);

  $view     = $vars['view'];

  $options  = $view->style_plugin->options;

  // No need to add anything if there are no rows. With server-side processing
  // the table is rendered empty on purpose: DataTables fetches the rows.
  $is_serverside = $view->style_plugin->is_serverside();
  if ($is_serverside) {
    module_load_include('inc', 'datatables', 'datatables.server');
  }
  if (!$vars['rows'] && !$is_serverside) {
    return;
  }
  $handler  = $view->style_plugin;

  $fields   = &$view->field;
  $columns  = $handler->sanitize_columns($options['columns'], $fields);

  $position = 0;
  $column_filters = array();
  $column_split = array();
  $date_fields = array();
  $serverside = $is_serverside;
  foreach ($columns as $field => $column) {
    $column_options = NULL;
    if (isset($options['hidden_columns'][$field])) {
      switch ($options['hidden_columns'][$field]) {
        case 'expandable':
          $datatable_options['expandable'] = TRUE;
          // expandable columns are not hidden, but use the class 'none'
          $column_options['className'] = 'none';
          break;
        case 'hidden':
          // Hidden columns get the visible init option set to false.
          $column_options['visible'] = FALSE;
          break;
        default:
          $column_options['visible'] = TRUE;
      }
    }

    // Render the header labels.
    // TODO: what to do if field != column (field displayed with other column)?
    if ($field == $column && empty($fields[$field]->options['exclude'])) {
      // Overrides clicksort head defined in
      // template_preprocess_views_view_table().
      $vars['header'][$field] = check_plain(!empty($fields[$field]) ? $fields[$field]->label() : '');
      $column_options['title'] = $vars['header'][$field];
      // Add a column name and database column name
      $column_options['name'] = $fields[$field]->field_alias;
      $column_options['data'] = $field;

      // Responsive: columns with a low "Responsive priority" (setting of the
      // table style) are hidden first when the table gets too wide for its
      // container. DataTables hides the columns with the highest number first
      // and, among equal priorities, the right-most one.
      $responsive = isset($options['info'][$field]['responsive']) ? $options['info'][$field]['responsive'] : '';
      if ($responsive === RESPONSIVE_PRIORITY_LOW) {
        $column_options['responsivePriority'] = 1000;
      }
      elseif ($responsive === RESPONSIVE_PRIORITY_MEDIUM) {
        $column_options['responsivePriority'] = 100;
      }
      else {
        $column_options['responsivePriority'] = 1;
      }

      // Set column alignment
      if (!empty($options['info'][$field]['align'])) {
        $column_options['className'] = str_replace('views-align-', 'dt-', $options['info'][$field]['align']);
      }

      if (empty($options['info'][$field]['sortable']) || !$fields[$field]->click_sortable()) {
        $column_options['orderable'] = FALSE;
      }
      else {
        // Attempt to autodetect the type of field in order to handle sorting
        // correctly.
        // last_render does not exist when the table is rendered without rows
        // (server-side processing).
        $last_render = isset($fields[$field]->last_render) ? (string) $fields[$field]->last_render : '';
        if (backdrop_strlen($last_render) != backdrop_strlen(strip_tags($last_render))) {
          $column_options['type'] = 'html';
        }
        $column_options['orderable'] = TRUE;
      }
      // Dates: the type "date" would make DataTables put the class
      // dt-type-date (right aligned) on the header, overriding the alignment
      // set in the style options. The column is declared as text instead and
      // sorted by the raw value, which is added to the cells as data-order.
      if (_datatables_is_date_field($fields[$field])) {
        $column_options['type'] = 'string';
        $date_fields[$field] = TRUE;
      }
      // Column filters (text box or drop-down with the distinct values).
      // With server-side processing only columns that can be filtered in SQL
      // get a filter, otherwise it would silently do nothing.
      $filter_mode = isset($options['filters'][$field]) ? $options['filters'][$field] : 'none';
      if (in_array($filter_mode, array('text', 'select'))) {
        if (!$is_serverside || datatables_server_field_target($fields[$field])) {
          $column_filters[$field] = $filter_mode;
          // A field that shows several values in one cell is split, so the
          // drop-down offers every single value (client-side filtering).
          $item_split = _datatables_item_split($fields[$field]);
          if ($item_split) {
            $column_split[$field] = $item_split;
          }
        }
      }

      $datatable_options['columns'][] = $column_options;

      // Set default sort order.
      if ($options['default'] == $field) {
        $datatable_options['order'] = [
          'idx' => $position,
          'dir' => $options['info'][$field]['default_sort_order']
        ];
      }
      $position++;
    }
  }

  // Add default sorting from View if not set in table options
  if (!isset($datatable_options['order'])) {
    foreach ($view->sort as $sortfield) {
      foreach ($view->field as $field) {
        if ($field->real_field == $sortfield->options['field']) {
          foreach ($datatable_options['columns'] as $position => $column) {
            if ($column['data'] == $field->field) {
              // Multi-column ordering using an array of column index and direction
              // For example: [[0, 'asc'],[1, 'desc']]
              $datatable_options['order'][] = array($position, strtolower($sortfield->options['order']));
              break 2;
            }
          }
        }
      }
    }
  }

  // No sort at all: DataTables would sort by the first column on its own.
  // An empty order keeps the order of the View (also with server-side
  // processing, where the View sorts).
  if (!isset($datatable_options['order'])) {
    $datatable_options['order'] = array();
  }

  // Enable table info display and other options, if necessary.
  $datatable_options['info'] = $options['elements']['table_info'];
  // Searching stays enabled even without the search box: DataTables also
  // switches off the column filters when "searching" is false. The box itself
  // is hidden by js/datatables.js.
  $datatable_options['searching'] = TRUE;
  $datatable_options['stateSave'] = $options['elements']['save_state'];

  $datatable_options['lengthChange'] = $options['pages']['length_change'];
  // "All" is not offered with server-side processing (see
  // datatables_server_parse_request()).
  $datatable_options['lengthMenu'] = $is_serverside
    ? [10, 25, 50, 100]
    : [10, 25, 50, 100, [ 'label' => 'All', 'value' => -1 ]];
  $datatable_options['pageLength'] = (int) $options['pages']['display_length'];

  // Enable ThemeRoller support, if necessary.
  if ($options['layout']['themeroller']) {
    $datatable_options['jQueryUI'] = TRUE;
  }

  // Pass the sDOM parameter, if one is specified.
  // Keep sdom config name for backwards compatibility with Drupal/DataTables1.x.
  if ($options['layout']['sdom']) {
    $datatable_options['dom'] = $options['layout']['sdom'];
  }

  // Always on: Responsive can only follow window resizes when DataTables
  // calculates the column widths (it then also listens to window resizes).
  $datatable_options['autoWidth'] = TRUE;

  // Enable full_numbers pagination if selected.
  switch ($options['pages']['pagination_style']) {
    case 'simple_numbers':
      $datatable_options['pagingType'] = 'simple_numbers';
      break;

    case 'scroller':
      $datatable_options['scroller'] = TRUE;
      $datatable_options['deferRender'] = TRUE;
      $datatable_options['scrollY'] = is_numeric($options['pages']['vheight']) ? $options['pages']['vheight'] . 'px' : $options['pages']['vheight'];
      $datatable_options['scrollCollapse'] = TRUE; // force height given in scrollY
      break;

    case 'no_pagination':
      $datatable_options['paging'] = FALSE;
      $datatable_options['info'] = FALSE;
      $datatable_options['lengthChange'] = FALSE;
      break;

    default:
      // Do nothing. No parameters need to be sent for the default (full
      // numbers) style.
      break;
  }

  // Sort keys of date cells (see above).
  $vars['data_order'] = array();
  if ($date_fields) {
    foreach ($vars['rows'] as $count => $row) {
      foreach (array_keys($date_fields) as $field) {
        if (!isset($view->result[$count]) || empty($fields[$field]->field_alias)) {
          continue;
        }
        $raw = isset($view->result[$count]->{$fields[$field]->field_alias}) ? $view->result[$count]->{$fields[$field]->field_alias} : '';
        if (is_numeric($raw)) {
          // Timestamps: fixed length, so text order is numeric order.
          $raw = sprintf('%012d', max(0, (int) $raw));
        }
        $vars['data_order'][$count][$field] = (string) $raw;
      }
    }
  }

  // Settings for our own JavaScript (not DataTables options).
  $datatable_options['backdrop'] = array(
    'serverSide' => $serverside,
    'filters' => $column_filters,
    'split' => $column_split,
    'cascade' => !empty($options['filter_options']['cascade']),
    // A table with a fixed height scrolls its body inside the page; its
    // header stays in place without any help.
    'hideSearch' => empty($options['elements']['search_box']),
    'sticky' => !empty($options['sticky']) && empty($datatable_options['scrollY']) && empty($view->live_preview),
    'stickyOffset' => isset($options['sticky_offset']) ? trim($options['sticky_offset']) : '',
  );
  if ($serverside) {
    // The rows are requested through Backdrop's Views Ajax callback
    // (views/ajax); see js/datatables.js and datatables.server.inc.
    module_load_include('inc', 'datatables', 'datatables.server');
    $datatable_options['processing'] = TRUE;
    $datatable_options['serverSide'] = TRUE;
    $datatable_options['backdrop']['exposedInput'] = datatables_server_exposed_input($view);
  }

  // A second header row holds the column filters.
  $vars['filters'] = $column_filters;
  if ($column_filters) {
    $datatable_options['orderCellsTop'] = TRUE;
  }

  // Enable Buttons (successor of TableTools) plugin support, if necessary.
  if (!empty($options['elements']['table_tools'])) {

    $datatable_options['buttons'] = array();

    if ($datatable_options['lengthChange']) {
      $datatable_options['buttons'][] = [
        'extend' => 'pageLength',
        'text' => t('Rows'),
        'titleAttr' => t('Select number of rows shown per page')
      ];
    }

    $datatable_options['buttons'][] = [
      'extend' => 'colvis',
      'text' => t('Columns'),
      'titleAttr' => t('Show/hide columns')
    ];
    $datatable_options['buttons'][] = [
      'extend' => 'collection',
      'text' => t('Export'),
      'titleAttr' => t('Export data of the table into various formats'),
      'buttons' => ['copy', 'csv', 'excel', 'pdf', 'print']
    ];

    // If a custom dom parameter is passed, assume that "B" is added, otherwise
    // add it manually.
    if (!$options['layout']['sdom']) {
      $datatable_options['dom'] = '<"dt-layout-row"<"dt-layout-cell dt-start"f><"dt-layout-cell dt-end"B>>
        <"dt-layout-row dt-layout-table"rt>
        <"dt-layout-row"<"dt-layout-cell dt-start"i><"dt-layout-cell dt-end"p>>';
    }
    backdrop_add_library('datatables', 'datatables-buttons');
  }

  // Note: a nice overview of text options - these strings can be translated
  $datatable_options['language'] = array(
    'emptyTable' => t('No data available in table'),
    'info' => t('Showing !_START_ to !_END_ of !_TOTAL_ entries', array('!_START_' => '_START_', '!_END_' => '_END_', '!_TOTAL_' => '_TOTAL_')),
    'infoEmpty' => t('Showing 0 to 0 of 0 entries'),
    'infoFiltered' => t('(filtered from !_MAX_ total entries)', array('!_MAX_' => '_MAX_')),
    'infoPostFix' => '',
    'processing' => t('Processing...'),
    'lengthMenu' => t('Show !_MENU_ entries', array('!_MENU_' => '_MENU_')),
    'loadingRecords' => t('Loading...'),
    'zeroRecords' => t( 'No matching records found'),
    'search' => t('Search'),
    'paginate' => array(
      'first' => t( 'First'),
      'previous' => t('Previous'),
      'next' => t('Next'),
      'last' => t('Last'),
    ),
    'aria' => array(
      'orderable' => t(': activate to order by this column'),
      'orderableReverse' => t(': activate to order by this column'),
    ),
    'buttons' => array(
      'copy' => t('Copy'),
      'copySuccess' => array(
        '1' => t('Copied 1 row to clipboard'),
        '_' => t('Copied %d rows to clipboard'),
      ),
      'copyTitle' => t('Copy to Clipboard'),
      'csv' => t('CSV'),
      'excel' => t('Excel'),
      'pdf' => t('PDF'),
      'print' => t('Print'),
    ),
  );

  // Tell the editor that the preview shows only some of the rows.
  $preview_limit = _datatables_preview_limit($view);
  if (!empty($view->live_preview) && $preview_limit > 0 && count($vars['rows']) >= $preview_limit) {
    $vars['title'] = t('Preview: only the first @count rows are loaded. The limit is set in the style settings.', array('@count' => $preview_limit));
  }

  $vars['id'] = _datatables_get_id();
  // The parent table preprocess adds Backdrop's own sticky header (a cloned
  // header); this module makes the real header sticky, see js/datatables.js.
  $vars['classes'] = array_diff($vars['classes'], array('sticky-enabled', 'responsive-enabled'));
  $vars['classes'][] = 'display';
  $vars['classes'][] = 'nowrap';  // recommended for responsive tables

  backdrop_add_library('datatables', 'datatables');
  backdrop_add_js(array('datatables' => array('#' . $vars['id'] => $datatable_options)), array('type' => 'setting', 'scope' => JS_DEFAULT));
}

/**
 * Returns the maximum number of rows loaded in the Views preview (0 = all).
 *
 * Views saved before this option existed do not have it.
 */
function _datatables_preview_limit($view) {
  $pages = $view->style_plugin->options['pages'];
  return isset($pages['preview_limit']) ? max(0, (int) $pages['preview_limit']) : 100;
}

/**
 * Tells whether a view uses the DataTables style with a Views pager replaced
 * by DataTables.
 */
function _datatables_view_uses_datatables($view) {
  return !empty($view->style_plugin)
    && $view->style_plugin instanceof datatables_style_plugin
    && $view->style_plugin->options['pages']['pagination_style'] != 'no_pagination';
}

/**
 * Tells whether a view is rendered with DataTables server-side processing.
 */
function _datatables_view_is_serverside($view) {
  return _datatables_view_uses_datatables($view)
    && $view->style_plugin->is_serverside();
}

/**
 * Implements hook_views_pre_view().
 *
 * Picks up a DataTables request that arrived through views/ajax. Views has
 * already loaded the view, checked access, set the display and the
 * contextual arguments, and merged the POST data into $_GET (so exposed
 * filters work as on a normal page).
 */
function datatables_views_pre_view(&$view, &$display_id, &$args) {
  if (empty($view->dom_id) || empty($_POST['datatables']) || !is_array($_POST['datatables'])) {
    return;
  }
  if (!empty($view->is_attachment) || !empty($view->datatables_request)) {
    return;
  }
  if ($view->display_handler->get_option('style_plugin') != 'datatables') {
    return;
  }

  module_load_include('inc', 'datatables', 'datatables.server');
  $request = datatables_server_parse_request($_POST['datatables']);
  // Only answer requests meant for this very view instance.
  if ($request['dom_id'] !== $view->dom_id) {
    return;
  }

  // The request must not leak into exposed input, pagers or sort links.
  unset($_POST['datatables'], $_GET['datatables'], $_REQUEST['datatables']);

  $view->datatables_request = $request;
  $view->datatables_role = 'main';
  // The query result of this request depends on the DataTables parameters, so
  // it must never be served from or stored in the Views cache.
  $view->display_handler->set_option('cache', array('type' => 'none', 'options' => array()));
  // We need the number of matching rows for "recordsFiltered".
  $view->get_total_rows = TRUE;
}

/**
 * Implements hook_views_query_alter().
 *
 * DataTables has its own pager, so the Views pager is replaced by a pager that
 * renders nothing.
 */
function datatables_views_query_alter(&$view, &$query) {
  if (!_datatables_view_uses_datatables($view)) {
    return;
  }

  // A new pager object is needed for every view: get_plugin() returns one
  // cached instance per plugin name for the whole request, bound to the view
  // that asked first, which breaks pages with several views.
  $pager = views_get_plugin('pager', 'some');
  $pager->init($view, $view->display[$view->current_display], array('items_per_page' => 0, 'offset' => 0));
  if (_datatables_view_is_serverside($view)) {
    // Limit and offset are applied in datatables_views_post_build().
    $pager->options['items_per_page'] = 1;
  }
  else {
    // Client-side processing: request all records. The Views preview (shown
    // while editing the view) only gets a limited number of rows because it is
    // reloaded after every change.
    $preview_limit = !empty($view->live_preview) ? _datatables_preview_limit($view) : 0;
    $pager->options['items_per_page'] = $preview_limit;
  }
  $view->query->pager = $pager;

  // Searching or filtering a Field API column needs its table in the query.
  if (!empty($view->datatables_request) && _datatables_view_is_serverside($view)) {
    module_load_include('inc', 'datatables', 'datatables.server');
    datatables_server_join_field_tables($view);
  }
}

/**
 * Implements hook_views_post_build().
 */
function datatables_views_post_build(&$view) {
  if (!_datatables_view_is_serverside($view)) {
    return;
  }
  module_load_include('inc', 'datatables', 'datatables.server');

  if (!empty($view->datatables_request)) {
    datatables_server_apply_request(
      $view,
      $view->datatables_request,
      isset($view->datatables_role) ? $view->datatables_role : 'main',
      isset($view->datatables_exclude) ? $view->datatables_exclude : NULL
    );
  }
  elseif (empty($view->is_attachment) && empty($view->live_preview) && !empty($view->build_info['query']) && $view->build_info['query'] instanceof SelectQueryInterface) {
    // Normal page request: the table is rendered empty, DataTables then asks
    // for the first page itself. No need to run a query for rows we discard.
    $view->build_info['query']->where('1 = 0');
    if (!empty($view->build_info['count_query']) && $view->build_info['count_query'] instanceof SelectQueryInterface) {
      $view->build_info['count_query']->where('1 = 0');
    }
  }
}

/**
 * Implements hook_views_ajax_data_alter().
 *
 * Replaces the HTML commands of views/ajax by the DataTables answer.
 */
function datatables_views_ajax_data_alter(&$commands, $view) {
  if ($view && !empty($view->datatables_response)) {
    $commands = array(
      array(
        'command' => 'datatablesResponse',
        'data' => $view->datatables_response,
      ),
    );
  }
}

/**
 * Returns an unique DataTable id
 */
function _datatables_get_id() {
  static $datatable_id;
  return 'datatable-' . ++$datatable_id;
}

/**
 * Implements hook_autoload_info().
 */
function datatables_autoload_info() {
  return array(
    'datatables_style_plugin' => 'views/datatables_style_plugin.inc',
  );
}

/**
 * Implements hook_element_info().
 *
 * Define an element to wrap around tableselect. For information on how to use
 * this element, refer to Backdrop's Form API documentation at
 * https://docs.backdropcms.org/form_api
 *
 * For information on datatable settings, refer to the documentation for
 * theme_datatable() in this file.
 */
function datatables_element_info() {
  $types['datatable_tableselect'] = array(
    '#input' => TRUE,
    '#js_select' => TRUE,
    '#multiple' => TRUE,
    '#process' => array('form_process_tableselect'),
    '#options' => array(),
    '#empty' => '',
    '#theme' => 'datatable_tableselect',
  );
  return $types;
}

/**
 *  Returns HTML for a table with radio buttons or checkboxes.
 *
 * Adds datatable functionality.
 */
function theme_datatable_tableselect($variables) {
  $element = &$variables['element'];
  $header = &$element['#header'];
  $attributes = &$element['#attributes'];

  if (isset($element['#options'])) {
    $datatable_options = !empty($attributes['datatable_options']) ? $attributes['datatable_options'] : array();

    // Column settings can either be set with the global options
    // or in each header definition.
    if (!isset($datatable_options['columns'])) {
      foreach ($header as $key => $cell) {
        if (isset($cell['datatable_options'])) {
          $datatable_options['columns'][] = $cell['datatable_options'];
          if (is_array($header[$key])) {
            unset($header[$key]['datatable_options']);
          }
        }
      }
    }

    // Set unique id.
    if (!isset($attributes['id'])) {
      $attributes['id'] = _datatables_get_id();
    }

    backdrop_add_library('datatables', 'datatables');
    backdrop_add_js(array('datatables' => array('#' . $attributes['id'] => $datatable_options)), 'setting');
    unset($attributes['datatable_options']);

  }

  return theme('tableselect', $variables);
}

/**
 * Describes how the values of a multi-value field are joined in one cell.
 *
 * @return array|null
 *   array('type' => 'ul'|'ol'|'separator', 'separator' => string) or NULL when
 *   the field shows one value per cell.
 */
function _datatables_item_split($handler) {
  if (!($handler instanceof views_handler_field_field) || empty($handler->multiple) || empty($handler->options['group_rows'])) {
    return NULL;
  }
  $type = !empty($handler->options['multi_type']) ? $handler->options['multi_type'] : 'separator';
  $split = array('type' => $type);
  if ($type == 'separator') {
    $separator = isset($handler->options['separator']) ? $handler->options['separator'] : ', ';
    // Same filtering as the field handler applies when it renders the cell.
    $split['separator'] = filter_xss_admin($separator);
  }
  return $split;
}

/**
 * Whether a field handler outputs a date.
 */
function _datatables_is_date_field($handler) {
  return $handler instanceof views_handler_field_date || $handler instanceof views_handler_field_datetime;
}
